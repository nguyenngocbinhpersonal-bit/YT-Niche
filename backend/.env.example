# Copy to .env:  cp .env.example .env
# Key: https://console.cloud.google.com/apis/credentials
# (enable "YouTube Data API v3" in the same project)
YOUTUBE_API_KEY=

# --- Postgres ---------------------------------------------------------------
# Without Docker: start Postgres yourself (or `docker compose up -d postgres` from
# the project root, which publishes it on 127.0.0.1:5433 by default) and
# set host/port below. Inside docker-compose these variables are filled in
# automatically (POSTGRES_HOST=postgres) -- no need to touch them.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=niches
POSTGRES_USER=niches
POSTGRES_PASSWORD=niches
# Or a single line instead of the five variables above:
# NICHE_DATABASE_URL=postgresql://niches:niches@localhost:5433/niches
# A separate Postgres schema instead of "public" -- handy for tests/several
# copies on one database:
# NICHE_DB_SCHEMA=public

# --- background worker (python3 worker.py) -------------------------------
# Reread the counters of fresh videos — vph24h,
# viewsGained24h, acceleration and title/thumbnail change detection come from this.
WORKER_HOT_INTERVAL_MIN=180
WORKER_HOT_PERIOD=7d
WORKER_HOT_LIMIT=1000

# Once a day: a wide refresh + channel snapshots + charts.
WORKER_DAILY_INTERVAL_MIN=1440
WORKER_FULL_PERIOD=30d
WORKER_FULL_LIMIT=3000
WORKER_REGIONS=US
WORKER_TRENDING=1

# Topics we keep fresh. One search call per topic per day
# out of a budget of 100 — up to ~90 topics is safe.
# WORKER_QUERIES=ai automation,faceless history,neural networks for business
WORKER_QUERY_PERIOD=24h
WORKER_QUERY_PAGES=1

# --- MCP transport -------------------------------------------------------
# stdio (default) or streamable-http
# MCP_TRANSPORT=stdio
# MCP_PORT=8765
